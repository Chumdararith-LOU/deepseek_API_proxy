#!/usr/bin/env node

import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const args = process.argv.slice(2);

const bun = spawnSync('bun', ['--version'], { stdio: 'ignore' });
if (!bun.error) {
  const r = spawnSync('bun', [resolve(root, 'src/cli.ts'), ...args], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

if (existsSync(resolve(root, 'dist/cli.js'))) {
  const r = spawnSync(process.execPath, [resolve(root, 'dist/cli.js'), ...args], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

console.error('[dsg] No runtime found. Install Bun (https://bun.sh) or run "bun run build" first.');
process.exit(1);
